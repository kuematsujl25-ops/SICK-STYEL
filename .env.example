# Local Node: npm run setup:local loads .env.bootstrap without printing keys.
# Cloudflare production uses D1 binding DB and Worker Secrets, never this file.
SETUP_TOKEN=
ADMIN_EMAIL=
TOKEN_ENCRYPTION_KEY=
APP_ORIGIN=
COOKIE_SECURE=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_API_VERSION=v26.0
INSTAGRAM_ALLOWED_USER_ID=
INSTAGRAM_ENABLE_MESSAGING=false
META_WEBHOOK_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
MAINTENANCE_MODE=false
