{
  "name": "sickstyle-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run build:cloudflare --silent && node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "migrate:check": "node scripts/migrate.js",
    "migrate:apply": "node scripts/migrate.js --apply",
    "verify:deployment": "node scripts/verify-deployment.js",
    "setup:local": "node scripts/setup-local.js",
    "admin:create": "node scripts/create-admin.js",
    "dev:cloudflare": "wrangler dev",
    "build:cloudflare": "wrangler deploy --dry-run --outdir .wrangler/build",
    "db:local": "wrangler d1 migrations apply sickstyle-db --local",
    "deploy": "npm test && node scripts/cloudflare-deploy.js",
    "migrate:export:d1": "node scripts/export-d1.js",
    "admin:create:remote": "node scripts/create-admin-remote.js",
    "test:node": "node --test tests/app.test.js tests/instagram.test.js tests/amazon.test.js tests/password.test.js",
    "cloud:setup": "node scripts/cloud-setup.js",
    "admin:reset:remote": "node scripts/create-admin-remote.js --reset",
    "integrations:instagram": "node scripts/set-secrets.js instagram",
    "integrations:amazon": "node scripts/set-secrets.js amazon",
    "integrations:amazon-refresh": "node scripts/set-secrets.js amazon-refresh",
    "ai:task": "node scripts/ai-staff/run-task.js",
    "ai:review": "node scripts/ai-staff/review-code.js",
    "deploy:existing": "node scripts/deploy-existing.js",
    "verify:existing": "node scripts/verify-existing.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
