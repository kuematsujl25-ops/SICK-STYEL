{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sickstyle-manager",
  "main": "workers/index.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sickstyle-db",
      "database_id": "009fbd34-6b04-4a82-8e33-cfc44c2416ec",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "COOKIE_SECURE": "true",
    "META_API_VERSION": "v26.0",
    "INSTAGRAM_ENABLE_MESSAGING": "true",
    "MAINTENANCE_MODE": "false",
    "APP_ORIGIN": "https://sickstyle-manager.sickstyle-74h4.workers.dev"
  },
  "triggers": {
    "crons": [
      "* * * * *",
      "0 0 * * *",
      "10 0 * * *",
      "0 11 * * *",
      "0 13 * * *"
    ]
  },
  "observability": {
    "enabled": false
  },
  "send_metrics": false,
  "account_id": "0e7f3c8d35e879a843cda721fc0435f0"
}
