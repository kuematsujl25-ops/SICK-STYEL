{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sickstyle-manager",
  "main": "workers/index.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"sickstyle-db","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "vars": {"COOKIE_SECURE":"true","META_API_VERSION":"v26.0","INSTAGRAM_ENABLE_MESSAGING":"false","MAINTENANCE_MODE":"false"},
  "triggers": {"crons":["0 0 * * *","10 0 * * *"]},
  "observability": {"enabled":false},
  "send_metrics": false
}
